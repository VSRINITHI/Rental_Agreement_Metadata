NVIDIA_API_KEY=nvapi-your-key-here
# Any chat model from https://build.nvidia.com that follows instructions well.
# A text instruct model is faster than a vision model for DOCX text extraction.
NVIDIA_MODEL=meta/llama-3.1-70b-instruct

# Optional tuning
NVIDIA_READ_TIMEOUT=120
NVIDIA_MAX_RETRIES=4
FEWSHOT_K=2
WORKERS=2

# Optional: Google Gemini configuration (via run_with_gemini.py)
GEMINI_API_KEY=your-gemini-key-here
GEMINI_MODEL=gemini-flash-lite-latest

